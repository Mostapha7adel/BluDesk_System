generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum ProjectStatus {
  NEW
  ANALYSIS
  DESIGN
  DEVELOPMENT
  TESTING
  COMPLETED
  CANCELLED
}

enum InternalProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  SALARIES
  HOSTING
  RENT
  MARKETING
  EQUIPMENT
  MISCELLANEOUS
}

enum TransactionType {
  INCOME
  EXPENSE
  DEPOSIT
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  PERMISSION_CHANGE
  PASSWORD_CHANGE
}

// ─── Roles & Permissions ───

model Role {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(50)
  slug        String          @unique @db.VarChar(50)
  description String?         @db.Text
  isSystem    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  users          User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(100)
  slug        String          @unique @db.VarChar(100)
  group       String          @db.VarChar(50)
  description String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ─── Users & Authentication ───

model User {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  email          String          @unique @db.VarChar(100)
  password       String          @db.VarChar(255)
  phone          String?         @unique @db.VarChar(20)
  image          String?         @db.VarChar(255)
  roleId         Int
  status         UserStatus      @default(ACTIVE)
  refreshToken   String?         @db.Text
  resetToken     String?         @db.VarChar(255)
  resetTokenExp  DateTime?
  loginAttempts  Int             @default(0)
  lockUntil      DateTime?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  role               Role            @relation(fields: [roleId], references: [id])
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  createdTransactions  FinanceTransaction[] @relation("TransactionCreator")
  cancelledTransactions FinanceTransaction[] @relation("TransactionCanceller")
  approvedSalaries     SalaryPayment[]
  createdExpenses      Expense[]
  internalProjectNotes InternalProjectNote[]

  @@index([deletedAt])
  @@index([status])
  @@index([roleId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(500)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ─── Employees ───

model Employee {
  id              Int             @id @default(autoincrement())
  employeeNumber  String          @unique @db.VarChar(20)
  nationalId      String?         @unique @db.VarChar(20)
  name            String          @db.VarChar(100)
  email           String?         @unique @db.VarChar(100)
  phone           String?         @db.VarChar(20)
  image           String?         @db.VarChar(255)
  position        String          @db.VarChar(100)
  department      String          @db.VarChar(100)
  salary          Decimal         @db.Decimal(12, 2)
  hireDate        DateTime
  status          EmployeeStatus  @default(ACTIVE)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assignedProjects  ProjectEmployee[]
  salaryPayments    SalaryPayment[]

  @@index([status])
  @@index([department])
  @@index([department, status])
  @@index([deletedAt])
}

// ─── Projects ───

model Project {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(200)
  clientName      String          @db.VarChar(200)
  description     String?         @db.Text
  totalCost       Decimal         @db.Decimal(14, 2)
  depositAmount   Decimal         @default(0) @db.Decimal(14, 2)
  remainingAmount Decimal         @db.Decimal(14, 2)
  startDate       DateTime
  deliveryDate    DateTime
  status          ProjectStatus   @default(NEW)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  assignedEmployees ProjectEmployee[]
  statusHistory     ProjectStatusHistory[]

  @@index([status])
  @@index([clientName])
  @@index([deletedAt])
  @@index([name])
}

model ProjectEmployee {
  id         Int      @id @default(autoincrement())
  projectId  Int
  employeeId Int
  createdAt  DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model ProjectStatusHistory {
  id        Int           @id @default(autoincrement())
  projectId Int
  fromStatus ProjectStatus?
  toStatus  ProjectStatus
  changedBy Int?
  createdAt DateTime      @default(now())

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
}

// ─── Internal Projects ───

model InternalProject {
  id          Int                   @id @default(autoincrement())
  name        String                @db.VarChar(200)
  description String?               @db.Text
  status      InternalProjectStatus @default(PLANNING)
  progress    Int                   @default(0)
  startDate   DateTime?
  endDate     DateTime?
  deletedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  teamMembers InternalProjectMember[]
  notes       InternalProjectNote[]

  @@index([status])
  @@index([deletedAt])
  @@index([name])
}

model InternalProjectMember {
  id               Int             @id @default(autoincrement())
  internalProjectId Int
  name             String          @db.VarChar(100)
  role             String          @db.VarChar(100)
  createdAt        DateTime        @default(now())

  internalProject  InternalProject @relation(fields: [internalProjectId], references: [id], onDelete: Cascade)

  @@index([internalProjectId])
}

model InternalProjectNote {
  id               Int             @id @default(autoincrement())
  internalProjectId Int
  content          String          @db.Text
  createdBy        Int
  createdAt        DateTime        @default(now())

  internalProject  InternalProject @relation(fields: [internalProjectId], references: [id], onDelete: Cascade)
  creator          User            @relation(fields: [createdBy], references: [id])

  @@index([internalProjectId])
}

// ─── Treasury / Finance ───

model Treasury {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(100)
  balance     Decimal         @default(0) @db.Decimal(14, 2)
  description String?         @db.Text
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          Int             @id @default(autoincrement())
  treasuryId  Int
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  description String?         @db.Text
  reference   String?         @db.VarChar(100)
  date        DateTime        @default(now())
  createdBy   Int
  cancelledAt DateTime?
  cancelledBy Int?
  createdAt   DateTime        @default(now())

  treasury    Treasury        @relation(fields: [treasuryId], references: [id])
  creator     User            @relation("TransactionCreator", fields: [createdBy], references: [id])
  canceller   User?           @relation("TransactionCanceller", fields: [cancelledBy], references: [id])

  @@index([type])
  @@index([date])
  @@index([treasuryId, type, date])
}

// ─── Expenses ───

model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String?         @db.Text
  date        DateTime
  receipt     String?         @db.VarChar(255)
  createdBy   Int
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  creator     User            @relation(fields: [createdBy], references: [id])

  @@index([category])
  @@index([date])
  @@index([createdBy])
  @@index([deletedAt])
  @@index([category, date])
}

// ─── Audit Logs ───

model AuditLog {
  id        Int         @id @default(autoincrement())
  userId    Int
  action    AuditAction
  entity    String      @db.VarChar(50)
  entityId  Int?
  metadata  Json?
  ipAddress String?     @db.VarChar(45)
  userAgent String?     @db.Text
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ─── Salaries ───

enum SalaryStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

model SalaryPayment {
  id          Int          @id @default(autoincrement())
  employeeId  Int
  employee    Employee     @relation(fields: [employeeId], references: [id])
  amount      Decimal      @db.Decimal(12, 2)
  month       Int
  year        Int
  status      SalaryStatus @default(PENDING)
  approvedBy  Int?
  approvedAt  DateTime?
  notes       String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  approver    User?        @relation(fields: [approvedBy], references: [id])

  @@unique([employeeId, month, year])
  @@index([status])
  @@index([month, year])
  @@index([employeeId])
  @@index([approvedBy])
}
